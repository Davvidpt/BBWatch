# Copy to .env for local development (never commit real .env)
APP_ENV=local
ADMIN_PASSWORD=generate-a-long-random-admin-password
SESSION_SECRET=generate-a-different-random-string-at-least-32-chars
CRON_SECRET=generate-a-third-random-string-at-least-24-chars
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_STANDARD_TOKEN
TELEGRAM_BOT_TOKEN=YOUR_NEW_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_GROUP_CHAT_ID
